# ==============================================================================
# DBS DA3 - University Hostel Administration & Logistics Management System
# Neo4j AuraDB Environment Configuration Template
# ==============================================================================
# NOTE: DO NOT commit real secrets, passwords, or credentials to git.
# Copy this file to .env and fill in your actual credentials.

# Server Configuration
PORT=5000
NODE_ENV=development

# Neo4j AuraDB Connection Settings
NEO4J_URI=neo4j+s://78fcafdc.databases.neo4j.io
NEO4J_USERNAME=78fcafdc
NEO4J_PASSWORD=your_password_here
NEO4J_DATABASE=78fcafdc

# Frontend Target Backend URL (Vite / React)
# Local: http://localhost:5000
# Production Render: https://dbsss-backend.onrender.com (or your Render service URL)
VITE_API_URL=https://dbsss-backend.onrender.com
